    <string name='app_name'>AutoGłośnik</string>
    <string name='service_name'>AutoGłośnik — przełączanie rozmowy</string>
    <string name='service_description'>Podczas rozmowy w Telefonie Google lub Samsung używa czujnika zbliżeniowego, aby przełączać słuchawkę i głośnik. Nie odczytuje ani nie zapisuje treści ekranu.</string>
    <string name='tab_home'>Strona główna</string>
    <string name='tab_support'>Wsparcie</string>
    <string name='home_lead'>Automatycznie przełącza rozmowę w obsługiwanej aplikacji Telefon: przy uchu — słuchawka, po odsunięciu — głośnik.</string>
